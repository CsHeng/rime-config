# Ignore everything by default; allowlist only what we intend to track.
*

!.gitignore
!README.md
!AGENTS.md
!.agents/
!.agents/**
!cmd/
!cmd/**
!*.custom.yaml
!custom_phrase_user.dict.yaml.example

# skin / jsonnet
!resources/
!resources/**
*.cskin

# generated keyboard files (jsonnet output)
resources/**/.*.keyboard
resources/**/scripts/

custom_phrase_user.dict.yaml
custom_phrase_user.txt

# never track secrets / local env
cmd/.env
cmd/frontends.yaml

# local artifacts (target dir content should not be tracked)
build/
.DS_Store
**/.DS_Store

# ignore local symlinks/helpers
cmd/**/SharedSupport
