# Ignore everything by default; allowlist only what we intend to track.
*

!.gitignore
!README.md
!AGENTS.md
!.agents/
!.agents/**
!cmd/
!cmd/**
!*.custom.yaml
!custom_phrase_user.dict.yaml.example

# Active change proposals; unrelated historical notes remain ignored.
!notes/
notes/*
!notes/windows-dependency-cleanup-design.md
!notes/windows-dependency-cleanup-plan.md

# skin / jsonnet
!resources/
!resources/**
*.cskin

# generated keyboard files (jsonnet output)
resources/**/.*.keyboard
resources/**/scripts/

custom_phrase_user.dict.yaml
custom_phrase_user.txt

# never track secrets / local env
cmd/.env
cmd/frontends.yaml
cmd/frontends.json
cmd/frontends.json.*.tmp

# local artifacts (target dir content should not be tracked)
build/
.DS_Store
**/.DS_Store

# ignore local symlinks/helpers
cmd/**/SharedSupport
